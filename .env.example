# Copiar este archivo como .env y completar con los datos de tu proyecto Supabase
# (Project Settings -> API). El archivo .env NO se sube al repositorio.

VITE_SUPABASE_URL=https://TU-PROYECTO.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-public-key

# Clave de la API de Anthropic (Claude), para el script de prueba de IA en scripts/ia/.
# SIN prefijo VITE_ a propósito: nunca debe terminar en el bundle del navegador.
# Conseguirla en https://console.anthropic.com (Settings -> API Keys).
ANTHROPIC_API_KEY=sk-ant-tu-clave
